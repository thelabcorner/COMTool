{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:comtool-v2:schema:v1-draft:portable-value",
  "title": "PortableValue",
  "description": "Top-level tagged value used when an operation returns dynamically typed host/script data. Nested JSON values retain normal JSON typing.",
  "oneOf": [
    {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "const": "null" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "boolean" },
        "value": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "number" },
        "value": { "type": "number" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "string" },
        "value": { "type": "string" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "array" },
        "value": { "type": "array" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "object" },
        "value": { "type": "object" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "artifact" },
        "value": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 256 },
            "mediaType": { "type": "string", "minLength": 1, "maxLength": 256 },
            "bytes": { "type": "integer", "minimum": 0 },
            "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
            "expiresAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
