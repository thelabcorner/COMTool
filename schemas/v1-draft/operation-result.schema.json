{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:comtool-v2:schema:v1-draft:operation-result",
  "title": "OperationResult",
  "type": "object",
  "required": [
    "protocolVersion",
    "id",
    "ok",
    "status",
    "retryable",
    "execution",
    "targetState",
    "timing"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "id": { "type": ["string", "null"], "maxLength": 128 },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$",
      "maxLength": 256
    },
    "ok": { "type": "boolean" },
    "status": {
      "enum": [
        "completed",
        "invalid_request",
        "unsupported_protocol",
        "unsupported_operation",
        "precondition_failed",
        "postcondition_failed",
        "target_unavailable",
        "host_busy",
        "operation_failed",
        "ambiguous",
        "timeout",
        "cancelled",
        "reconciliation_required",
        "internal_error"
      ]
    },
    "retryable": { "type": "boolean" },
    "execution": {
      "enum": ["not_started", "definitely_not_executed", "completed", "unknown"]
    },
    "targetState": {
      "enum": ["known", "known_changed", "busy", "reconciliation_required", "unavailable", "unknown"]
    },
    "target": { "$ref": "urn:comtool-v2:schema:v1-draft:target" },
    "result": { "$ref": "urn:comtool-v2:schema:v1-draft:portable-value" },
    "error": { "$ref": "urn:comtool-v2:schema:v1-draft:error" },
    "warnings": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["kind", "message"],
        "properties": {
          "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
          "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "context": {}
        },
        "additionalProperties": false
      }
    },
    "evidence": {},
    "timing": {
      "type": "object",
      "required": ["totalMs"],
      "properties": {
        "queueMs": { "type": "number", "minimum": 0 },
        "retryMs": { "type": "number", "minimum": 0 },
        "executeMs": { "type": "number", "minimum": 0 },
        "verifyMs": { "type": "number", "minimum": 0 },
        "totalMs": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "ok": { "const": true } },
        "required": ["ok"]
      },
      "then": {
        "required": ["operation", "result"],
        "properties": {
          "status": { "const": "completed" },
          "retryable": { "const": false },
          "execution": { "const": "completed" },
          "targetState": { "enum": ["known", "known_changed"] }
        },
        "not": { "required": ["error"] }
      },
      "else": {
        "required": ["error"],
        "properties": {
          "status": { "not": { "const": "completed" } }
        },
        "not": { "required": ["result"] }
      }
    }
  ],
  "additionalProperties": false
}
