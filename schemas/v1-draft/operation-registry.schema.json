{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:comtool-v2:schema:v1-draft:operation-registry",
  "title": "OperationRegistry",
  "type": "object",
  "required": ["schemaVersion", "protocolVersion", "operations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolVersion": { "const": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "description", "scope", "target", "requiredFacets", "mutationClass", "idempotency", "replayPolicy", "ambiguousFailure", "requiresLease", "directMode", "brokerMode"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(?:\\\\.[a-z][a-z0-9_-]*)+$",
            "maxLength": 256
          },
          "version": { "type": "integer", "minimum": 1 },
          "description": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "scope": { "enum": ["core", "generic_host", "host_specific"] },
          "hosts": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" }
          },
          "target": { "enum": ["none", "optional", "required"] },
          "requiredFacets": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" }
          },
          "mutationClass": {
            "enum": [
              "read_only",
              "idempotent_write",
              "conditional_write",
              "non_idempotent_write",
              "document_lifecycle",
              "host_lifecycle",
              "external_side_effect",
              "debug_state",
              "runtime_state",
              "unknown"
            ]
          },
          "idempotency": { "enum": ["idempotent", "conditional", "non_idempotent", "unknown"] },
          "replayPolicy": { "enum": ["safe", "guarded", "never"] },
          "ambiguousFailure": { "enum": ["safe_retry", "stop", "reconcile"] },
          "requiresLease": { "type": "boolean" },
          "directMode": { "type": "boolean" },
          "brokerMode": { "type": "boolean" },
          "inputSchema": { "type": ["string", "null"], "format": "uri-reference" },
          "resultSchema": { "type": ["string", "null"], "format": "uri-reference" },
          "notes": {
            "type": "array",
            "items": { "type": "string", "maxLength": 1024 }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "scope": { "const": "host_specific" } },
              "required": ["scope"]
            },
            "then": {
              "required": ["hosts"],
              "properties": { "hosts": { "minItems": 1 } }
            }
          },
          {
            "if": {
              "properties": { "target": { "const": "none" } },
              "required": ["target"]
            },
            "then": {
              "properties": { "requiresLease": { "const": false } }
            }
          },
          {
            "if": {
              "properties": { "mutationClass": { "const": "read_only" } },
              "required": ["mutationClass"]
            },
            "then": {
              "properties": {
                "idempotency": { "const": "idempotent" },
                "replayPolicy": { "const": "safe" }
              }
            }
          },
          {
            "if": {
              "properties": { "idempotency": { "const": "non_idempotent" } },
              "required": ["idempotency"]
            },
            "then": {
              "properties": { "replayPolicy": { "const": "never" } }
            }
          },
          {
            "if": {
              "properties": { "mutationClass": { "const": "unknown" } },
              "required": ["mutationClass"]
            },
            "then": {
              "properties": {
                "idempotency": { "const": "unknown" },
                "replayPolicy": { "const": "never" },
                "ambiguousFailure": { "const": "reconcile" }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
