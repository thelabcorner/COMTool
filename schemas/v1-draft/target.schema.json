{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:comtool-v2:schema:v1-draft:target",
  "title": "TargetDescriptor",
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "expectedGeneration": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "processIdentity": {
      "type": "object",
      "required": ["pid", "startedAt"],
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "executablePath": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["id", "host", "generation", "state", "ownership"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "host": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "adapter": { "type": "string", "minLength": 1, "maxLength": 128 },
    "adapterVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "hostVersion": { "type": ["string", "null"], "maxLength": 128 },
    "generation": { "type": "integer", "minimum": 0 },
    "state": {
      "enum": ["known", "known_changed", "busy", "reconciliation_required", "unavailable", "unknown"]
    },
    "ownership": { "enum": ["preexisting", "owned", "unknown"] },
    "process": { "$ref": "#/$defs/processIdentity" },
    "capabilityFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  },
  "additionalProperties": false
}
