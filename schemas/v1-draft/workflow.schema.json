{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:comtool-v2:schema:v1-draft:workflow",
  "title": "WorkflowRequest",
  "type": "object",
  "required": ["protocolVersion", "id", "target", "steps"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "target": { "$ref": "urn:comtool-v2:schema:v1-draft:target#/$defs/ref" },
    "targetLease": { "type": "boolean", "default": true },
    "onError": { "enum": ["stop", "continue"], "default": "stop" },
    "recovery": { "enum": ["stop", "reconcile"], "default": "reconcile" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["id", "operation", "input"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "operation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
          },
          "input": {},
          "policy": {
            "type": "object",
            "properties": {
              "retryBudgetMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
              "operationSoftTimeoutMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
              "workerWatchdogMs": { "type": "integer", "minimum": 100, "maximum": 3600000 },
              "onAmbiguous": { "enum": ["stop", "reconcile"] }
            },
            "additionalProperties": false
          },
          "preconditions": {
            "type": "array",
            "maxItems": 128,
            "items": { "$ref": "urn:comtool-v2:schema:v1-draft:assertion" }
          },
          "postconditions": {
            "type": "array",
            "maxItems": 128,
            "items": { "$ref": "urn:comtool-v2:schema:v1-draft:assertion" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
