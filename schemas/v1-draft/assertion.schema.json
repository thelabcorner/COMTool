{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:comtool-v2:schema:v1-draft:assertion",
  "title": "OperationAssertion",
  "type": "object",
  "required": ["id", "source", "predicate"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source": {
      "type": "object",
      "required": ["operation", "input"],
      "properties": {
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
        },
        "input": {}
      },
      "additionalProperties": false
    },
    "predicate": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["equals", "not_equals", "truthy", "falsey", "exists", "not_exists"]
        },
        "expected": { "$ref": "urn:comtool-v2:schema:v1-draft:portable-value" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "enum": ["equals", "not_equals"] }
            },
            "required": ["kind"]
          },
          "then": { "required": ["expected"] },
          "else": {
            "not": { "required": ["expected"] }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
