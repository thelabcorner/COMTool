{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comtool.dev/schema/v1/workflow-submit-input.schema.json",
  "title": "WorkflowSubmitInput",
  "description": "Input for core.workflow.submit. The outer OperationRequest supplies the job id and optional strong target reference.",
  "type": "object",
  "additionalProperties": false,
  "required": ["steps", "onError"],
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation", "input"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
          },
          "input": {},
          "preconditions": {
            "type": ["array", "null"],
            "maxItems": 128,
            "items": { "$ref": "assertion.schema.json" }
          },
          "postconditions": {
            "type": ["array", "null"],
            "maxItems": 128,
            "items": { "$ref": "assertion.schema.json" }
          }
        }
      }
    },
    "onError": { "type": "string", "enum": ["stop", "continue"] },
    "targetLease": { "type": "boolean", "default": true }
  }
}
