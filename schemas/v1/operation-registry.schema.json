{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:comtool-v2:schema:v1:operation-registry",
  "title": "OperationRegistry",
  "type": "object",
  "required": [
    "schemaVersion",
    "protocolVersion",
    "authority",
    "generatedPolicy",
    "operations"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "protocolVersion": { "const": 1 },
    "authority": {
      "const": "ComTool.Runtime.BuiltInOperations.Catalog"
    },
    "generatedPolicy": {
      "const": "checked_in_snapshot_tested_against_runtime_catalog"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "mutationClass",
          "requiresTarget",
          "executionScope",
          "host",
          "requiresLease",
          "mutationResolution"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9_-]*(?:\\.[A-Za-z][A-Za-z0-9_-]*)+$",
            "maxLength": 256
          },
          "version": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "mutationClass": {
            "enum": [
              "read_only",
              "idempotent_write",
              "conditional_write",
              "non_idempotent_write",
              "document_lifecycle",
              "external_side_effect",
              "unknown"
            ]
          },
          "requiresTarget": { "type": "boolean" },
          "executionScope": {
            "enum": ["runtime", "host"]
          },
          "host": {
            "type": ["string", "null"],
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "requiresLease": { "type": "boolean" },
          "mutationResolution": {
            "enum": ["fixed", "declared_or_unknown"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}