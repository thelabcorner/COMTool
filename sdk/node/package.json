{
  "name": "@comtool/v2-node",
  "version": "0.1.0",
  "description": "Pure Node.js client and runner for COM Tool V2's persistent programmatic Adobe surface.",
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    }
  },
  "files": [
    "README.md",
    "index.mjs",
    "index.d.ts",
    "lib/",
    "bin/"
  ],
  "bin": {
    "comtool-v2-run": "./bin/comtool-run.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "node test/typecheck.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
