<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ComTool.Protocol\ComTool.Protocol.csproj" />
    <ProjectReference Include="..\ComTool.Hosts.Abstractions\ComTool.Hosts.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\eson-runtime.js"
                      LogicalName="ComTool.Hosts.Illustrator.Assets.eson-runtime.js" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="VerifyCanonicalEsonRuntime"
          BeforeTargets="BeforeBuild"
          Condition="Exists('$(MSBuildProjectDirectory)\..\..\..\..\..\eson\dist\vendor-eson-runtime.js')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\sync-eson.ps1&quot; -Check"
          WorkingDirectory="$(MSBuildProjectDirectory)\..\.." />
  </Target>

</Project>
